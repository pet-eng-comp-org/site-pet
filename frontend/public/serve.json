{
  "redirects": [
    {
      "source": "/subscription",
      "destination": "/inscricoes",
      "type": 301
    }
  ],
  "rewrites": [
    {
      "source": "/projetos/:projeto",
      "destination": "/projetos/_projeto/index.html"
    }
  ],
  "headers": [
    {
      "source": "assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
